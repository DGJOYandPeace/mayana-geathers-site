{# =========================================================================
   BOOK MAYANA — a reference page, scoped to speaking, sound healing/guided
   meditation events, and trainings/consulting. Therapy enquiries are routed
   to Bridges to Healing by the notice at the top.
   ========================================================================= #}

<section class="tone tone--mist hero-page">
  <div class="wrap reveal">
    <p class="eyebrow">Invite Mayana</p>
    <h1>Book <span class="accent-word">Mayana</span></h1>
    {# --- INTRO COPY (verbatim from the live site) --- #}
    <p class="lede hero-page__sub">
      Mayana is available for sound healing/guided meditations, speaking events, podcasts,
      and trainings. Mayana also offers consulting for organizations and businesses to
      support trauma-informed practices.
    </p>
  </div>
</section>

{# The black-and-white portrait, set beside the copy in a contained column —
   the About page's treatment rather than a full-width band. #}
<section class="tone tone--sage section">
  <div class="wrap reveal">
    <div class="split split--narrow-first" style="align-items:center">
      {% if assets.has[site.images.booking] %}
      <img class="portrait portrait--wide" src="/assets/img/{{ site.images.booking }}"
           alt="{{ site.images.bookingAlt }}"
           {{ ("/assets/img/" ~ site.images.booking) | imgAttrs | safe }} loading="lazy">
      {% endif %}
      <div>
        <p class="label label--accent">Sound healing &amp; guided meditation</p>
        <h2>Bring a moment of stillness to your gathering</h2>
        <p class="lede">
          Mayana leads guided meditation and sound healing for retreats, workplaces,
          private events and live gatherings.
        </p>
        <p style="margin-top:1.5rem">
          <a class="btn btn--primary" href="/contact/?reason=booking">Enquire about an event</a>
        </p>
      </div>
    </div>
  </div>
</section>

{# --- THERAPY ROUTING NOTICE -------------------------------------------- #}
<section class="tone tone--mist section--tight">
  <div class="wrap reveal">
    <div class="notice">
      <p>
        <strong>Looking for therapy?</strong>
        I see clients through my group practice, Bridges to Healing. This page is for
        speaking, sound healing and training bookings.
      </p>
      <a class="btn btn--primary btn--sm" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
    </div>
  </div>
</section>

