---
layout: layouts/base.njk
title: Guided Meditation
description: "Original guided meditations written and recorded by Mayana Geathers — listen in full, right here."
permalink: /guided-meditation/
---
{# =========================================================================
   GUIDED MEDITATION — the centrepiece and a return-visit page.
   Built as a growing library: adding a track means adding one object to
   src/_data/meditations.json; nothing here changes.
   Bandcamp has been cut, so nothing on this page links out to purchase.
   ========================================================================= #}

<section class="hero hero--page">
  <div class="wrap">
    <p class="eyebrow">Listen</p>
    <h1>Guided <span class="accent-word">Meditation</span></h1>
    <p class="lede hero__sub" style="margin-bottom:0">
      Written and recorded by Mayana. Press play and let everything else wait a moment.
    </p>
  </div>
</section>

{# --- THE INVITATION -----------------------------------------------------
   Her own intro copy, set as a composition with the photograph rather than a
   paragraph of running text. The pull quote is lifted from the same passage,
   so nothing here is invented. #}
<section class="section--tight invite">
  <div class="wrap">
    <div class="split split--narrow-first invite__grid">
      <figure class="invite__figure">
        <img src="/assets/img/{{ site.images.invitation }}" alt="{{ site.images.invitationAlt }}"
             width="853" height="1280" loading="lazy">
      </figure>
      <div>
        <p class="label label--accent">An invitation</p>
        {# REPLACE ME — this headline is written by us, not Mayana. Her own
           words follow beneath it. Swap in a line of hers if she'd rather. #}
        <p class="invite__quote">Close your eyes. Everything else can wait a moment.</p>
        {# --- INTRO COPY (verbatim from the live site) --- #}
        <p class="prose">{{ meditations.intro }}</p>
        {# REPLACE ME — a short personal note from Mayana can sit here.
           Delete this block if it isn't wanted. #}
        <p class="invite__signoff">&mdash; Mayana</p>
      </div>
    </div>
  </div>
</section>

{# --- THE PLAYER ---------------------------------------------------------
   The gift track carries giftOnly:true — the player reveals it only once a
   visitor has signed up (remembered in their browser). #}
<section class="section--tight" style="padding-top:0">
  <div class="wrap">
    {% set playerId = "library-player" %}
    {% set playerTracks = library %}
    {% set playerHeading = "The library" %}
    {% set playerCompact = false %}
    {% include "partials/player.njk" %}
  </div>
</section>

{# --- WRITTEN DETAIL PER MEDITATION ------------------------------------- #}
<section class="section band">
  <div class="wrap">
    <p class="eyebrow">The meditations</p>
    <h2 style="margin-bottom:2rem">What each one is for</h2>

    {% for t in meditations.tracks %}
    <article class="entry-body" id="{{ t.slug }}">
      <div class="split split--narrow-first">
        <div>
          {# Cover art is the release the track belongs to — confirmed from
             the collection's track listing. #}
          <div class="cover" style="max-width:13rem">
            <img src="{{ t.cover }}" alt="Cover art for {{ t.album }}" loading="lazy" width="420" height="420">
          </div>
          <p class="item__meta" style="margin-top:0.85rem">
            {{ t.album }}{% if t.duration %} &middot; {{ t.duration }}{% endif %}
          </p>
        </div>
        <div class="prose">
          <h3>{{ t.title }}</h3>
          <p>{{ t.description }}</p>
          {% if t.useFor.length %}
            <p class="label" style="margin-top:1.75rem">Use this meditation for</p>
            <ul class="use-list">
              {% for use in t.useFor %}<li>{{ use }}</li>{% endfor %}
            </ul>
          {% endif %}
          {% if t.closing %}<p class="closing-line">{{ t.closing }}</p>{% endif %}
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{# --- THE COLLECTION THESE COME FROM ------------------------------------
   Context only — no purchase link, per the decision to cut Bandcamp. #}
{% set release = albums.releases["dawning-of-a-new-day"] %}
<section class="section--tight">
  <div class="wrap">
    <div class="split split--plate">
      <img src="{{ release.cover }}" alt="{{ release.coverAlt }}" loading="lazy" width="700" height="700">
      <div>
        <p class="label">The collection</p>
        <h3>{{ release.title }}</h3>
        <p>{{ release.description }}</p>
      </div>
    </div>
  </div>
</section>

{# --- SIGNUP + THE GIFT --------------------------------------------------
   The snippet plays for everyone in the player above; signing up reveals the
   full recording in the panel beneath the form. #}
<section class="section">
  <div class="wrap">
    {% include "partials/signup.njk" %}
    {% include "partials/gift.njk" %}
  </div>
</section>
