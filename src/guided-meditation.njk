---
layout: layouts/base.njk
title: Guided Meditation
description: "Original guided meditations written and recorded by Mayana Geathers — listen in full, right here."
permalink: /guided-meditation/
---
{# =========================================================================
   GUIDED MEDITATION — Stage 1 centrepiece and one of the two return-visit
   pages. Built as a growing library: adding a track means adding one object
   to src/_data/meditations.json, nothing here changes.
   ========================================================================= #}

<section class="hero hero--page">
  <div class="ambient" aria-hidden="true"><div class="ambient__grain"></div></div>
  <div class="wrap">
    <div class="hero__inner">
      <p class="eyebrow" style="color:rgba(255,252,248,0.7)">Listen</p>
      <h1>Guided <span class="gold">Meditation</span></h1>
      <p class="hero__sub">Written and recorded by Mayana. Press play and let everything else wait a moment.</p>
    </div>
  </div>
</section>

{# --- INTRO COPY (verbatim from the live site) --- #}
<section class="section section--tight">
  <div class="wrap">
    <p class="lede prose">{{ meditations.intro }}</p>
  </div>
</section>

{# --- THE PLAYER ---------------------------------------------------------
   The gift track is appended with giftOnly:true — the player reveals it only
   after a visitor has signed up (remembered in their browser). #}
<section class="section" style="padding-top:0">
  <div class="wrap">
    {% set playerId = "library-player" %}
    {% set playerTracks = library %}
    {% set playerHeading = "The library" %}
    {% set playerCompact = false %}
    {% include "partials/player.njk" %}
  </div>
</section>

{# --- WRITTEN DETAIL PER MEDITATION ------------------------------------- #}
<section class="section band">
  <div class="wrap">
    <p class="eyebrow">The meditations</p>
    <h2>What each one is for</h2>

    <div style="margin-top:2.5rem">
      {% for t in meditations.tracks %}
      <article class="med-entry" id="{{ t.slug }}">
        <div class="cover" style="--cover-h: {{ 114 + (loop.index0 * 17) }}">
          {# REPLACE ME — cover art. While coverFile is null in
             meditations.json a soft generated placeholder is shown; no stock
             photography has been invented. #}
          <span class="cover__ph">Cover art coming</span>
        </div>
        <div>
          <h3>{{ t.title }}</h3>
          <p>{{ t.description }}</p>
          {% if t.useFor.length %}
            <p class="eyebrow" style="margin-top:1.5rem">Use this meditation for</p>
            <ul class="use-list">
              {% for use in t.useFor %}<li>{{ use }}</li>{% endfor %}
            </ul>
          {% endif %}
          {% if t.closing %}<p class="closing-line">{{ t.closing }}</p>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# --- FULL ALBUMS, BANDCAMP-ONLY ---------------------------------------- #}
<section class="section">
  <div class="wrap">
    <p class="eyebrow">Full collections</p>
    <h2>Albums on Bandcamp</h2>
    <p class="lede prose" style="margin-bottom:2.25rem">
      These full-length collections live on Bandcamp, where you can hear them in full and buy a copy.
    </p>
    <div class="grid grid--2">
      {% for album in albums.bandcamp %}
      <article class="card album">
        <div class="album__cover">
          <img src="{{ album.cover }}" alt="{{ album.coverAlt }}" loading="lazy" width="420" height="420">
        </div>
        <div>
          <h3 style="margin-bottom:0.5rem">{{ album.title }}</h3>
          <p>{{ album.description }}</p>
          {% if album.photo %}
            {# ASSET: supporting photography for this release. CONFIRM it
               belongs here — remove `photo` from albums.json if not. #}
            <img src="{{ album.photo }}" alt="{{ album.photoAlt }}"
                 class="album__photo" loading="lazy" width="520" height="340">
          {% endif %}
          <p style="margin-top:1.25rem">
            <a class="btn btn--soft btn--sm" href="{{ album.url }}" target="_blank" rel="noopener">Listen on Bandcamp</a>
          </p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# --- DAVID'S SOUND HEALING (cross-promo only, not in Mayana's player) --- #}
<section class="section section--tight band">
  <div class="wrap">
    <article class="card card--tint prose" style="max-width:none">
      <p class="eyebrow">Also worth hearing</p>
      <h3>{{ albums.davidSoundHealing.title }}</h3>
      <p class="latest__meta">{{ albums.davidSoundHealing.byline }}</p>
      <p>{{ albums.davidSoundHealing.description }}</p>
      <p style="margin-top:1.25rem">
        <a class="btn btn--soft btn--sm" href="{{ albums.davidSoundHealing.url }}" target="_blank" rel="noopener">Listen on Bandcamp</a>
      </p>
    </article>
  </div>
</section>

{# --- SIGNUP (the gift track unlocks in the player above) ---------------- #}
<section class="section">
  <div class="wrap">
    {% include "partials/signup.njk" %}
  </div>
</section>
