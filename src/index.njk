---
layout: layouts/base.njk
title: false
description: "Mayana Geathers — feminist therapist (LMFT), writer, and creator of original guided meditations."
permalink: /
navOverHero: true
---
{#
  ===========================================================================
  HOME
  A full-bleed hero the nav floats over, copy to the left across the open part
  of the frame, dissolving at its foot into the first tone. From there the
  page steps down through hue — mist, sage, moss, forest, deep — so scrolling
  reads as descent rather than as a stack of documents.
  ===========================================================================
#}
{% set heroImage = site.images.hero if assets.has[site.images.hero] else false %}
<section class="hero-full">
  {% if heroImage %}
    <img class="hero-full__img" src="/assets/img/{{ heroImage }}" alt="{{ site.images.heroAlt }}"
         {{ ("/assets/img/" ~ heroImage) | imgAttrs | safe }} fetchpriority="high">
  {% endif %}
  <div class="hero-full__veil" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-full__copy">
      <p class="eyebrow">Feminist therapist &middot; Writer &middot; Guided meditation</p>
      {# Three beats — affirm, release, return — the shape of the practice itself. #}
      <h1>Affirm your <span class="accent-green">worth</span>. Release.
        Come back to <span class="accent-word">yourself</span>.</h1>
      <p class="hero-full__sub">{{ site.tagline }}</p>
      <div class="btn-row">
        <a class="btn btn--light" href="#meditations">Listen now</a>
        <a class="btn btn--outline" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
      </div>
      <p class="hero-full__note">{{ site.consultCta.note }}</p>
    </div>
  </div>
</section>

{# ---------------------------------------------- THE FOUR MEDITATIONS ---- #}
<section class="tone tone--mist section" id="meditations">
  <div class="wrap reveal">
    <p class="eyebrow">Guided meditation</p>
    <h2>Four meditations, written and voiced by Mayana</h2>
    <p class="lede prose" style="margin-bottom:2.5rem">
      Press play and let the page open around you. Each one names what it&rsquo;s for,
      so you can choose the practice that fits the moment.
    </p>
    <div>
      {% set playerId = "home-player" %}
      {% set playerTracks = library %}
      {% set playerHeading = "Choose a meditation" %}
      {% set playerCompact = false %}
      {% include "partials/player.njk" %}
    </div>
    <p style="margin-top:2rem"><a class="link-more" href="/guided-meditation/">Read about each meditation</a></p>
  </div>
</section>

{# ------------------------------------------------- PRIMARY CONVERSION -- #}
<section class="tone tone--sage section">
  <div class="wrap reveal">
    {% include "partials/signup.njk" %}
    {% include "partials/gift.njk" %}
  </div>
</section>

{# ------------------------------------------------- QUIET PHOTO MOMENT -- #}
{% if assets.has[site.images.portraitProfile] %}
<figure class="breath tone tone--moss">
  <img src="/assets/img/{{ site.images.portraitProfile }}" alt="{{ site.images.portraitProfileAlt }}" loading="lazy"
       {{ ("/assets/img/" ~ site.images.portraitProfile) | imgAttrs | safe }}>
  <figcaption class="wrap breath__copy reveal">
    <p class="breath__quote">There is a power to slowing down a moment.</p>
    <p class="breath__attr">Mayana Geathers</p>
  </figcaption>
</figure>
{% endif %}

{# --------------------------------------------------------- WRITING ----- #}
{% set latestPiece = writing.entries[0] %}
<section class="tone tone--forest section">
  <div class="wrap reveal">
    <p class="eyebrow">Writing</p>
    <ul class="index">
      <li>
        <a class="item" href="{{ latestPiece.url }}" target="_blank" rel="noopener">
          <span class="item__num">New</span>
          <span>
            <span class="item__meta">{{ latestPiece.source }}</span>
            <h3 class="item__title" style="margin-top:0.45rem">{{ latestPiece.title }}</h3>
            <span class="item__excerpt">Mayana on {{ latestPiece.topics | join(", ") | lower }}.</span>
          </span>
          <span class="item__aside"><span class="link-more">Read</span></span>
        </a>
      </li>
    </ul>
    <p style="margin-top:1.75rem"><a class="link-more" href="/written-work/">All written work</a></p>
  </div>
</section>

{# ----------------------------------------------------- TESTIMONIALS ---- #}
<section class="tone tone--deep section">
  <div class="wrap reveal">
    <p class="eyebrow">In their words</p>
    {% for t in testimonials.items %}
    <blockquote class="quote{% if loop.first %} quote--lead{% endif %}">
      <p>&ldquo;{{ t.quote }}&rdquo;</p>
      <cite>{{ t.attribution }}</cite>
    </blockquote>
    {% endfor %}
    <div class="notice" style="margin-top:clamp(2rem,5vw,3rem)">
      <p>
        <strong>Follow along on Instagram</strong>
        Reflections, new meditations, and notes from Mayana&rsquo;s practice.
      </p>
      <a class="btn btn--outline btn--sm" href="{{ site.urls.instagram }}" target="_blank" rel="noopener">@mayanageathers</a>
    </div>
  </div>
</section>
