---
layout: layouts/base.njk
title: Written Work
description: "Articles by Mayana Geathers on trauma, social justice, feminist therapy and the healing process."
permalink: /written-work/
---
{# =========================================================================
   WRITTEN WORK — a return-visit page, set as a numbered print index.
   Entries come from src/_data/writing.json; add an object to the top of that
   array to publish a new piece. The index is numbered because the entries
   are ordered newest-first — the number carries real sequence.
   ========================================================================= #}

<section class="hero hero--page">
  <div class="wrap">
    <p class="eyebrow">Read</p>
    <div class="hero__inner"><h1>Written <span class="accent-word">Work</span></h1></div>
    {# --- INTRO COPY (verbatim from the live site) --- #}
    <p class="lede hero__sub prose" style="margin-bottom:0">{{ writing.intro }}</p>
  </div>
</section>

<section class="section--tight">
  <div class="wrap">
    <div class="library__head" style="margin-bottom:0.75rem">
      <p class="label" style="margin:0">Published pieces</p>
      <span class="library__count">{{ writing.entries.length }} {{ "piece" if writing.entries.length == 1 else "pieces" }}</span>
    </div>

    <ul class="index">
      {% for piece in writing.entries %}
      <li>
        <a class="item" href="{{ piece.url }}" target="_blank" rel="noopener">
          <span class="item__num">{{ loop.index | pad2 }}</span>
          <span>
            <span class="item__meta">{{ piece.source }}{% if piece.date %} &middot; {{ piece.date | prettyDate }}{% endif %}</span>
            <h2 class="item__title" style="margin-top:0.45rem">{{ piece.title }}</h2>
            {# Placeholder excerpts are skipped so the page stays clean until
               real pull quotes arrive. #}
            {% if piece.excerpt and "REPLACE ME" not in piece.excerpt %}
              <span class="item__excerpt">{{ piece.excerpt }}</span>
            {% endif %}
          </span>
          <span class="item__aside"><span class="link-more">Read</span></span>
        </a>
      </li>
      {% endfor %}
    </ul>

    <p class="lede prose" style="margin-top:3rem">
      More writing is on the way. Join Mayana&rsquo;s list below and new pieces will find you.
    </p>
  </div>
</section>

<section class="section--tight" style="padding-bottom:clamp(3rem,7vw,5rem)">
  <div class="wrap">
    {% include "partials/signup.njk" %}
    {% include "partials/gift.njk" %}
  </div>
</section>
