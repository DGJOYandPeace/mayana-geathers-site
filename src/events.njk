---
layout: layouts/base.njk
title: Events
description: "Past events, gatherings and sound healing sessions with Mayana Geathers."
permalink: /events/
---
{# =========================================================================
   EVENTS — headed "Past Events" so it doesn't read as an abandoned calendar.
   Add objects to `upcoming` in src/_data/events.json and an Upcoming section
   appears above automatically.
   ========================================================================= #}

<section class="hero hero--page">
  <div class="wrap">
    <p class="eyebrow">Gatherings</p>
    <div class="hero__inner">
      <h1>{% if events.upcoming.length %}<span class="accent-word">Events</span>{% else %}Past <span class="accent-word">Events</span>{% endif %}</h1>
    </div>
    <p class="lede hero__sub" style="margin-bottom:0">
      Sound healing sessions, guided meditations and speaking engagements Mayana has led.
    </p>
  </div>
</section>

{% if events.upcoming.length %}
<section class="section--tight">
  <div class="wrap">
    <p class="eyebrow">Coming up</p>
    <ul class="index">
      {% for e in events.upcoming %}
      <li><div class="item">
        <span class="item__num">&mdash;</span>
        <span>
          <span class="item__meta">{{ e.dateLabel }}{% if e.time %} &middot; {{ e.time }}{% endif %}{% if e.location %} &middot; {{ e.location }}{% endif %}</span>
          <h2 class="item__title" style="margin-top:0.45rem">{{ e.title }}</h2>
          <span class="item__excerpt">{{ e.description }}</span>
        </span>
      </div></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<section class="section--tight{% if events.upcoming.length %} band{% endif %}">
  <div class="wrap">
    <p class="eyebrow">Looking back</p>
    <ul class="index">
      {% for e in events.past %}
      <li><div class="item">
        <span class="item__num">{{ loop.index | pad2 }}</span>
        <span>
          <span class="item__meta">{{ e.dateLabel }}{% if e.time %} &middot; {{ e.time }}{% endif %}{% if e.location %} &middot; {{ e.location }}{% endif %}</span>
          <h2 class="item__title" style="margin-top:0.45rem">{{ e.title }}</h2>
          <span class="item__excerpt">{{ e.description }}</span>
        </span>
      </div></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section--tight" style="padding-bottom:clamp(3rem,7vw,5rem)">
  <div class="wrap">
    <div class="notice">
      <p>
        <strong>Bring Mayana to your gathering</strong>
        Sound healing, guided meditation, speaking and trainings &mdash; for retreats, workplaces and private events.
      </p>
      <a class="btn btn--primary btn--sm" href="/book-mayana/">Book Mayana</a>
    </div>
  </div>
</section>
