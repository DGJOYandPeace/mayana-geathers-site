{#
  ===========================================================================
  Guided meditation player, set as a printed plate: ruled edges, ink type,
  no glass. Pressing play "blooms" it — the plate opens, the cover grows, the
  description sets, and a waveform of fine ink rules appears.

  Params (set with {% set %} before including):
    playerId      – unique id on the page
    playerTracks  – array of track objects to load
    playerHeading – library heading
    playerCompact – true to hide the library (homepage featured track)
  ===========================================================================
#}
{% set pid = playerId or "player" %}
<div class="player" id="{{ pid }}" data-player>
  <div class="player__body">
    <div class="player__now">
      <div class="cover" data-player-cover>
        <span class="cover__ph" data-player-cover-ph>Cover<br>art<br>to come</span>
      </div>

      <div class="player__meta">
        <p class="player__album" data-player-album></p>
        <h3 class="player__title" data-player-title>Select a meditation</h3>
        <p class="player__meta-line"><span data-player-meta></span></p>
        <p class="player__desc" data-player-desc></p>

        {# What this particular meditation is good for — revealed with the
           bloom, so choosing a track tells you why you'd choose it. #}
        <div class="player__use" data-player-use hidden>
          <p class="label" data-player-use-label>Use this meditation for</p>
          <ul data-player-use-list></ul>
        </div>

        <div class="player__wave" aria-hidden="true">
          {% for i in range(0, 40) %}<span style="animation-delay: -{{ (i * 0.13) | round(2) }}s"></span>{% endfor %}
        </div>
      </div>
    </div>

    <div class="player__transport">
      <button class="pbtn pbtn--sm" type="button" data-player-prev aria-label="Previous meditation">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5.5a1 1 0 0 1 2 0v5.2l8.5-5.55A1 1 0 0 1 19 6v12a1 1 0 0 1-1.5.85L9 13.3v5.2a1 1 0 0 1-2 0z"/></svg>
      </button>

      <button class="pbtn pbtn--play" type="button" data-player-toggle aria-label="Play">
        <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-play><path d="M8 5.5v13a1 1 0 0 0 1.53.85l10-6.5a1 1 0 0 0 0-1.7l-10-6.5A1 1 0 0 0 8 5.5z"/></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-pause hidden><path d="M7 4.5h3.5v15H7zM13.5 4.5H17v15h-3.5z"/></svg>
      </button>

      <button class="pbtn pbtn--sm" type="button" data-player-next aria-label="Next meditation">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 5.5a1 1 0 0 0-2 0v5.2L6.5 5.15A1 1 0 0 0 5 6v12a1 1 0 0 0 1.5.85L15 13.3v5.2a1 1 0 0 0 2 0z"/></svg>
      </button>

      <div class="player__scrub">
        <span class="player__time" data-player-elapsed>0:00</span>
        <input class="range" type="range" min="0" max="1000" value="0" step="1"
               data-player-seek aria-label="Seek within the meditation">
        <span class="player__time" data-player-remaining>-0:00</span>
      </div>

      <div class="player__volume">
        <button class="pbtn pbtn--sm" type="button" data-player-mute aria-label="Mute">
          <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-vol><path d="M4 9.5v5a1 1 0 0 0 1 1h3l4 3.4a.7.7 0 0 0 1.15-.54V4.64A.7.7 0 0 0 12 4.1L8 7.5H5a1 1 0 0 0-1 1zM16.4 8.1a1 1 0 0 0-1.3 1.52 3.2 3.2 0 0 1 0 4.76 1 1 0 1 0 1.3 1.52 5.2 5.2 0 0 0 0-7.8z"/></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-muted hidden><path d="M4 9.5v5a1 1 0 0 0 1 1h3l4 3.4a.7.7 0 0 0 1.15-.54V4.64A.7.7 0 0 0 12 4.1L8 7.5H5a1 1 0 0 0-1 1zM21 9.4 19.6 8l-2.1 2.1L15.4 8 14 9.4l2.1 2.1L14 13.6 15.4 15l2.1-2.1 2.1 2.1 1.4-1.4-2.1-2.1z"/></svg>
        </button>
        <input class="range" type="range" min="0" max="100" value="85" step="1"
               data-player-volume aria-label="Volume">
      </div>

      {# Loop the library: after the last meditation it returns to the first.
         On by default, so a session keeps going without being touched. #}
      <button class="pbtn pbtn--sm pbtn--toggle is-on" type="button"
              data-player-loop aria-pressed="true" aria-label="Loop the library">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 2l4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/>
          <path d="M7 22l-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>
        </svg>
      </button>
    </div>

    <p class="player__notice" data-player-notice hidden></p>

    {% if not playerCompact %}
    <div class="library">
      <div class="library__head">
        <h3>{{ playerHeading or "The library" }}</h3>
        <span class="library__count" data-player-count></span>
      </div>
      <ul class="library__list" data-player-list></ul>
    </div>
    {% endif %}
  </div>

  <audio data-player-audio preload="none"></audio>

  {# Track data — read by player.js. Audio and cover URLs are assembled at
     runtime from window.MG_CONFIG.audio, so the R2 bucket lives in one place. #}
  <script type="application/json" data-player-data>
    {{ playerTracks | dump | safe }}
  </script>
</div>
