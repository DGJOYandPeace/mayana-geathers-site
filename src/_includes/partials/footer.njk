<footer class="footer">
  <div class="ambient" aria-hidden="true"><div class="ambient__grain"></div></div>
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <div class="footer__logo">
          <img src="/assets/img/mayana-geathers-white-logo.webp" alt="{{ site.name }}" width="140" height="34">
        </div>
        {# Site-wide Bridges to Healing credit — general mention, so it links to
           the practice homepage, not the booking page. #}
        <p class="footer__practice">
          Mayana is a co-founder of
          <a href="{{ site.urls.practice }}" target="_blank" rel="noopener">Bridges to Healing: Counseling &amp; Training Center</a>,
          a feminist therapy group practice offering counseling, trainings and advocacy.
        </p>
      </div>

      <nav aria-label="Footer">
        <h4>Explore</h4>
        <ul>
          {% for item in site.nav %}
            <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <div>
        <h4>Connect</h4>
        <ul>
          <li><a href="{{ site.urls.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="{{ site.urls.practice }}" target="_blank" rel="noopener">Bridges to Healing</a></li>
          <li><a href="/contact/">Contact Mayana</a></li>
        </ul>
        <p style="margin-top:1.25rem">
          <a class="btn btn--ghost btn--sm" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
        </p>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__signoff">{{ site.signoff }}</span>
      <span>&copy; {{ build.year }} {{ site.name }}</span>
    </div>
  </div>
</footer>
