{#
  Nav. On the homepage it floats over the hero photograph (transparent, white)
  and solidifies once scrolled. The signature sits at the left rather than
  pinned to the centre, which gives the menu the whole middle of the bar. Elsewhere it sits on its own
  deep band so the white signature always has ground beneath it.
#}
<header class="nav{% if navOverHero %} nav--over{% endif %}" id="site-nav">
  <div class="wrap">
    <div class="nav__inner">
      <a class="nav__mark" href="/" aria-label="{{ site.name }} — home">
        <img src="/assets/img/{{ site.images.logo }}" alt="{{ site.name }}"
             {{ ("/assets/img/" ~ site.images.logo) | imgAttrs | safe }}>
      </a>

      <ul class="nav__links nav__links--desktop">
        {% for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>

      <div class="nav__end">
        <a class="nav__icon" href="{{ site.urls.instagram }}" target="_blank" rel="noopener" aria-label="Mayana on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      </div>

      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" data-nav-toggle>
        <span data-nav-toggle-label>Menu</span>
      </button>

      <div class="nav__drawer" id="nav-drawer">
        <ul class="nav__links nav__links--drawer">
          {% for item in site.nav %}
            <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
          <li><a href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a></li>
          <li><a href="{{ site.urls.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>
