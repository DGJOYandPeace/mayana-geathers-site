{#
  Site nav. Paper ground, hairline rule beneath.

  The wordmark is TYPESET rather than the supplied logo image: that logo is
  white-on-transparent and would be invisible on paper. If a dark or
  full-colour logo variant arrives, swap the <a> below for an <img>.
#}
<header class="nav" id="site-nav">
  <div class="wrap">
    <div class="nav__inner">
      {# The dark logo is used the moment the file appears in src/assets/img.
         Until then the wordmark is typeset — the supplied logo is white and
         would be invisible on paper. #}
      {% if assets.has[site.images.logoDark] %}
        <a class="nav__logo" href="/" aria-label="{{ site.name }} — home">
          <img src="/assets/img/{{ site.images.logoDark }}" alt="{{ site.name }}"
               {{ ("/assets/img/" ~ site.images.logoDark) | imgAttrs | safe }}>
        </a>
      {% else %}
        <a class="nav__mark" href="/">{{ site.name }}</a>
      {% endif %}

      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" data-nav-toggle>
        <span data-nav-toggle-label>Menu</span>
      </button>

      <div class="nav__drawer" id="nav-drawer">
        <ul class="nav__links">
          {% for item in site.nav %}
            <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>

        {# Site-wide therapy funnel CTA — the ONE place Bridges to Healing's
           /contact page is linked. Present on every page. #}
        <div class="nav__cta nav__cta--drawer">
          <a class="btn btn--outline btn--sm btn--block" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
        </div>
      </div>

      <div class="nav__cta nav__cta--desktop">
        <a class="btn btn--outline btn--sm" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
      </div>
    </div>
  </div>
</header>
