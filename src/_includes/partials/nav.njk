{#
  Site nav. The logo supplied is white-on-transparent, so the nav is always a
  translucent dark frosted strip — on the homepage it floats over the hero, on
  interior pages over that page's warm header band.
  FLAG: if a dark / full-colour logo variant arrives, a light nav becomes
  possible for pages that would rather open on cream.
#}
<header class="nav" id="site-nav">
  <div class="wrap">
    <div class="nav__inner">
      <a class="nav__logo" href="/" aria-label="{{ site.name }} — home">
        <img src="/assets/img/mayana-geathers-white-logo.webp" alt="{{ site.name }}" width="140" height="34">
      </a>

      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer" data-nav-toggle>
        <span data-nav-toggle-label>Menu</span>
        <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M1 1h14M1 6h14M1 11h14"/>
        </svg>
      </button>

      <div class="nav__drawer" id="nav-drawer">
        <ul class="nav__links">
          {% for item in site.nav %}
            <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>

        {# Site-wide therapy funnel CTA — the ONE place /contact on Bridges to
           Healing is linked. Present on every page. #}
        <div class="nav__cta nav__cta--drawer">
          <a class="btn btn--ghost btn--sm btn--block" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
        </div>
      </div>

      <div class="nav__cta nav__cta--desktop">
        <a class="btn btn--ghost btn--sm" href="{{ site.urls.practiceBooking }}" target="_blank" rel="noopener">{{ site.consultCta.label }}</a>
      </div>
    </div>
  </div>
</header>
